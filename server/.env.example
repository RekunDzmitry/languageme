DATABASE_URL=postgres://lm_user:lm_pass@localhost:5432/languageme
JWT_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
PORT=3000

# Public URL (used for OAuth redirect callbacks)
PUBLIC_URL=http://localhost:5173

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Configuration (GSD SDK)
# The GSD SDK uses ~/.pi/agent/auth.json for API keys
# Supported providers: anthropic, openai, google, etc.
# Set up your API keys using: pi config set-api-key <provider> <key>
